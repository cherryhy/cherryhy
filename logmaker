function setImg(src,cb){if(!src){IMG=null;cb&&cb();return}const im=new Image();im.onload=()=>{IMG=im;S.imgW=im.naturalWidth;S.imgH=im.naturalHeight;cb&&cb()};im.onerror=()=>{IMG=null;cb&&cb()};im.src=src}
function loadImg(file){const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>{
    const k=Math.min(1,1600/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=Math.round(im.width*k);c.height=Math.round(im.height*k);
    c.getContext('2d').drawImage(im,0,0,c.width,c.height);S.img=c.toDataURL('image/jpeg',.9);S.imgX=50;S.imgY=50;S.imgZ=1;
    setImg(S.img,()=>update(true))};im.onerror=()=>toast('이 이미지는 열 수 없어요. JPG나 PNG로 다시 골라 주세요.');im.src=r.result};r.readAsDataURL(file)}

