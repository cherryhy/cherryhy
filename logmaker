    if(x+w>maxW&&x>0){trimEnd(cur());lines.push([]);x=0}
    if(w>maxW){for(const ch of [...tk.t]){const c=mc.measureText(ch).width;if(x+c>maxW&&x>0){lines.push([]);x=0}cur().push({t:ch,k:tk.k,x,w:c});x+=c}continue}
    cur().push({t:tk.t,k:tk.k,x,w});x+=w}
