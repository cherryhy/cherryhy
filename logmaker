let LAST=null;
function draw(){
  const L=build();LAST=L;const cv=$('cv'),box=$('stage');
  const cssW=Math.min(box.clientWidth||L.W,L.W),k=cssW/L.W,dpr=Math.min(3,window.devicePixelRatio||1);
  cv.style.width=cssW+'px';cv.style.height=(L.H*k)+'px';cv.width=Math.round(cssW*dpr);cv.height=Math.round(L.H*k*dpr);
  paint(cv.getContext('2d'),L,k*dpr);
  $('dim').textContent=(L.W*2)+' × '+(L.H*2)+' px';
  const hit=$('hit');
  if(L.img){const off=(box.clientWidth-cssW)/2;hit.hidden=false;Object.assign(hit.style,{left:(off+L.img.x*k)+'px',top:(L.img.y*k)+'px',width:(L.img.w*k)+'px',height:(L.img.h*k)+'px'})}
  else hit.hidden=true;
}
function allText(){return [S.src,S.title,S.sub,...S.people.flatMap(p=>[p.n,p.l]),'가나다 글꼴 ×·'].join(' ')}
function ensureFonts(){if(!document.fonts||!document.fonts.load)return Promise.resolve();const t=allText();
  return Promise.all([F(400,16,'sans'),F(700,16,'sans'),F(400,16,'serif'),F(600,16,'serif'),'500 12px "IBM Plex Mono"'].map(f=>document.fonts.load(f,t).catch(()=>{})))}
let fontTick=0;
function redraw(){draw();const n=++fontTick;ensureFonts().then(()=>{if(n===fontTick)draw()})}

