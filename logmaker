let DL=null;
try{if(window.claude&&typeof claude.use==='function')claude.use('downloads').then(d=>{DL=d}).catch(()=>{})}catch(e){}
let tT;function toast(m){const t=$('toast');t.textContent=m;t.hidden=false;clearTimeout(tT);tT=setTimeout(()=>t.hidden=true,2800)}
async function makeBlob(){await ensureFonts();const L=build(),c=document.createElement('canvas');c.width=L.W*2;c.height=L.H*2;paint(c.getContext('2d'),L,2);
  return new Promise((res,rej)=>c.toBlob(b=>b?res(b):rej(new Error('PNG를 만들지 못했어요')),'image/png'))}
const fname=()=>'log_'+today.replace(/\./g,'')+'.png';
function showModal(blob){const u=URL.createObjectURL(blob);$('mimg').src=u;$('modal').hidden=false}
async function savePng(){
  let blob;try{blob=await makeBlob()}catch(e){toast('이미지를 만들지 못했어요. 잠시 뒤 다시 눌러 주세요.');return}
  if(DL){try{await DL.save({filename:fname(),data:blob});toast('저장했어요.');return}
    catch(e){if(e&&e.code==='declined'){toast('저장을 취소했어요.');return}if(e&&e.code==='rate_limited'){toast('저장 창이 이미 열려 있어요.');return}}}
  let standalone=false;try{standalone=window.top===window.self}catch(e){}
  if(standalone){const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=fname();document.body.appendChild(a);a.click();a.remove();
    setTimeout(()=>URL.revokeObjectURL(a.href),4000);toast('PNG를 내려받았어요. 안 받아졌다면 다시 눌러 주세요.');return}
  showModal(blob);
}
function copyPng(){
  try{if(!navigator.clipboard||!window.ClipboardItem)throw 0;
    navigator.clipboard.write([new ClipboardItem({'image/png':makeBlob()})]).then(()=>toast('이미지를 복사했어요. 붙여넣기 하면 돼요.'),()=>toast('이 화면에서는 복사가 막혀 있어요. PNG 저장을 써 주세요.'))}
  catch(e){toast('이 화면에서는 복사가 막혀 있어요. PNG 저장을 써 주세요.')}
}

/* ---------- start ---------- */
setPre();bind();syncParas();renderEditor();
setImg(S.img,()=>redraw());redraw();
let rz;window.addEventListener('resize',()=>{cancelAnimationFrame(rz);rz=requestAnimationFrame(draw)});
</script>
