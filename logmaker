<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>로그 메이커</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=Noto+Serif+KR:wght@400;600&family=IBM+Plex+Mono:wght@500&display=swap">
<style>
:root{
  /* layout: sticky live preview on the left, one settings column on the right; stacks on phones */
  --bg:#f2f3f5; --surface:#ffffff; --ink:#17181c; --muted:#6a6d75; --line:#e1e3e8; --field:#f7f8fa; --accent:#3d5afe;
  --ui:"Noto Sans KR","Apple SD Gothic Neo","Malgun Gothic",system-ui,sans-serif;
  --mono:"IBM Plex Mono","Noto Sans KR",ui-monospace,monospace;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0e0f11;--surface:#17181b;--ink:#ececef;--muted:#9a9ca4;--line:#2a2c31;--field:#111214;--accent:#8c9dff;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0e0f11;--surface:#17181b;--ink:#ececef;--muted:#9a9ca4;--line:#2a2c31;--field:#111214;--accent:#8c9dff;color-scheme:dark}
[hidden]{display:none!important}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font-family:var(--ui);font-size:14px;-webkit-text-size-adjust:100%}
.app{max-width:1400px;margin:0 auto;padding-block:20px 48px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
header.top{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 14px;margin-bottom:16px}
header.top h1{font-size:17px;font-weight:700;margin:0;letter-spacing:-.2px}
header.top p{margin:0;color:var(--muted);font-size:13px}
.grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,400px);gap:20px;align-items:start}
@media (max-width:900px){.grid{grid-template-columns:minmax(0,1fr)}}

/* preview */
.pv{position:sticky;top:max(12px,env(safe-area-inset-top,0px));display:flex;flex-direction:column;gap:10px;min-width:0}
.bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.bar .dim{margin-left:auto;font-family:var(--mono);font-size:11px;color:var(--muted)}
.stagebox{max-height:calc(100vh - 90px);overflow:auto;border-radius:6px}
.stage{position:relative;display:flex;justify-content:center}
#cv{display:block;box-shadow:0 1px 2px rgba(0,0,0,.06),0 8px 28px rgba(0,0,0,.08)}
#hit{position:absolute;cursor:grab;touch-action:none}
#hit.drag{cursor:grabbing}
@media (max-width:900px){
  .pv{top:0;z-index:5;background:var(--bg);padding:8px 0 10px;margin-top:-8px;border-bottom:1px solid var(--line)}
  .stagebox{max-height:42vh}
}

/* panel */
.panel{background:var(--surface);border:1px solid var(--line);border-radius:10px;display:flex;flex-direction:column;min-width:0}
.sec{padding:16px;display:flex;flex-direction:column;gap:12px}
.sec+.sec{border-top:1px solid var(--line)}
.sec h2{margin:0;font-size:12px;font-weight:700;color:var(--muted);letter-spacing:.2px}
label.f{display:flex;flex-direction:column;gap:5px;font-size:12px;color:var(--muted);min-width:0}
input[type=text],textarea{background:var(--field);border:1px solid var(--line);border-radius:6px;color:var(--ink);font:inherit;font-size:13.5px;padding:8px 10px;width:100%;box-sizing:border-box}
textarea{min-height:200px;resize:vertical;line-height:1.75}
:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
.people{display:flex;flex-direction:column;gap:8px}
.person{display:grid;grid-template-columns:22px 40px minmax(0,1fr) minmax(0,1fr) 32px;gap:8px;align-items:end}
.person .pn{font-family:var(--mono);font-size:11px;color:var(--muted);padding-bottom:10px}
.person .del{height:36px;width:32px;border:1px solid var(--line);border-radius:6px;background:transparent;color:var(--muted);font:inherit;font-size:16px;cursor:pointer;padding:0}
.person .del:disabled{opacity:.3;cursor:default}
.person:not(:first-child) label.f>span{display:none}
select{background:var(--field);border:1px solid var(--line);border-radius:6px;color:var(--ink);font:inherit;font-size:12.5px;padding:5px 8px}
.whosel{display:inline-flex;align-items:center;gap:6px}
.person input[type=color]{width:40px;height:36px;padding:3px;border:1px solid var(--line);border-radius:6px;background:var(--field);cursor:pointer;box-sizing:border-box}
.hint{font-size:12px;color:var(--muted);line-height:1.8;margin:0}
.hint code{font-family:var(--mono);font-size:11px;background:var(--field);border:1px solid var(--line);padding:1px 5px;border-radius:4px;color:var(--ink)}
.row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.row>.k{font-size:12px;color:var(--muted);width:44px;flex:none}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:7px;overflow:hidden;background:var(--field)}
.seg button{background:transparent;border:0;color:var(--muted);font:inherit;font-size:12.5px;padding:6px 12px;cursor:pointer;display:inline-flex;align-items:center;gap:6px}
.seg button+button{border-left:1px solid var(--line)}
.seg button[aria-pressed=true]{background:var(--surface);color:var(--ink);font-weight:700;box-shadow:inset 0 -2px 0 var(--ink)}
.sw{width:9px;height:9px;border-radius:50%;flex:none;box-shadow:0 0 0 1px rgba(0,0,0,.18)}
.paras{display:flex;flex-direction:column;gap:6px;max-height:420px;overflow:auto}
.para{border:1px solid var(--line);border-radius:8px;padding:9px 10px;display:flex;flex-direction:column;gap:7px}
.para.off{opacity:.45}
.para .ctl{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.para .num{font-family:var(--mono);font-size:10.5px;color:var(--muted);width:26px}
.para .seg button{padding:4px 9px;font-size:12px}
.para .eye{margin-left:auto;background:transparent;border:1px solid var(--line);border-radius:6px;color:var(--muted);font:inherit;font-size:12px;padding:4px 9px;cursor:pointer}
.para .ex{font-size:12.5px;color:var(--muted);line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;word-break:keep-all}
.checks{display:flex;flex-wrap:wrap;gap:6px}
.checks label{display:flex;align-items:center;gap:6px;font-size:12.5px;border:1px solid var(--line);border-radius:20px;padding:5px 11px;cursor:pointer}
.checks input{accent-color:var(--ink);margin:0}
.upl{position:relative;display:inline-flex;align-items:center;gap:6px;border:1px dashed var(--muted);border-radius:7px;padding:8px 13px;font-size:13px;cursor:pointer}
.upl input{position:absolute;inset:0;opacity:0;cursor:pointer}
.thumb{width:36px;height:46px;border-radius:4px;background:var(--field) center/cover no-repeat;border:1px solid var(--line)}
.sl{display:grid;grid-template-columns:44px 1fr 40px;align-items:center;gap:10px;font-size:12px;color:var(--muted)}
.sl input{accent-color:var(--ink);width:100%}
.sl output{font-family:var(--mono);font-size:11px;text-align:right;color:var(--ink)}
.btn{background:var(--ink);color:var(--surface);border:1px solid var(--ink);border-radius:7px;font:inherit;font-weight:700;font-size:13px;padding:8px 14px;cursor:pointer}
.btn.ghost{background:var(--surface);color:var(--ink);border-color:var(--line);font-weight:500}
.btn:hover{filter:brightness(1.1)}
.btn.warn{border-color:#d4483b;color:#d4483b}
.toast{position:fixed;left:50%;bottom:max(20px,env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--surface);font-size:13px;padding:9px 16px;border-radius:20px;z-index:30;max-width:calc(100% - 32px);text-align:center}
.modal{position:fixed;inset:0;background:rgba(10,10,12,.82);z-index:20;display:flex;flex-direction:column;align-items:center;gap:12px;overflow:auto;padding:max(16px,env(safe-area-inset-top,0px)) 16px max(16px,env(safe-area-inset-bottom,0px))}
.modal p{margin:0;font-size:13px;color:#fff;text-align:center;line-height:1.7}
.modal img{max-width:min(100%,720px);border-radius:4px}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<div class="app">
  <header class="top">
    <h1>로그 메이커</h1>
    <p>글을 붙여넣고 문단마다 대사·지문을 확인하면 PNG 로그가 돼요.</p>
  </header>

  <div class="grid">
    <section class="pv" aria-label="미리보기">
      <div class="bar">
        <button class="btn" type="button" id="save">PNG 저장</button>
        <button class="btn ghost" type="button" id="copy">이미지 복사</button>
        <span class="dim" id="dim"></span>
      </div>
      <div class="stagebox"><div class="stage" id="stage"><canvas id="cv" role="img" aria-label="로그 미리보기"></canvas><div id="hit" hidden></div></div></div>
    </section>

    <section class="panel" aria-label="편집">
      <div class="sec">
        <h2>인물 <span id="pCount" style="font-weight:500"></span></h2>
        <div class="people" id="people"></div>
        <div class="row"><button class="btn ghost" type="button" id="addP">+ 인물 추가</button></div>
      </div>

      <div class="sec">
        <h2>본문</h2>
        <label class="f" for="src">문단은 빈 줄로 나누고, 대사는 앞에 이름과 콜론을 붙여요.
          <textarea id="src"></textarea>
        </label>
        <p class="hint"><span id="hNames"></span> 처럼 이름으로 시작하면 그 사람 대사, 나머지는 지문이에요.<br>
        <code>**문장**</code> 형광펜 · <code>[[문장]]</code> 1번 인물 색 · <code>==문장==</code> 2번 인물 색 · <code>[[3:문장]]</code> 3번 인물 색</p>
      </div>

      <div class="sec">
        <h2>문단</h2>
        <div class="paras" id="paras"></div>
      </div>

      <div class="sec">
        <h2>스타일</h2>
        <div class="row"><span class="k">배치</span><div class="seg" data-key="layout"><button type="button" data-v="script">대본</button><button type="button" data-v="chat">말풍선</button></div></div>
        <div class="row" id="rightRow"><span class="k">오른쪽</span><select id="rightP" aria-label="말풍선 오른쪽에 둘 인물"></select><span class="hint">말풍선에서 오른쪽에 둘 인물</span></div>
        <div class="row"><span class="k">배경</span><div class="seg" data-key="theme"><button type="button" data-v="white">화이트</button><button type="button" data-v="mist">그레이</button><button type="button" data-v="dark">다크</button></div></div>
        <div class="row"><span class="k">글꼴</span><div class="seg" data-key="font"><button type="button" data-v="mix">대사 고딕 · 지문 명조</button><button type="button" data-v="sans">고딕</button><button type="button" data-v="serif">명조</button></div></div>
      </div>

      <div class="sec">
        <h2>이미지</h2>
        <div class="row">
          <div class="thumb" id="thumb" hidden></div>
          <label class="upl" for="imgIn">이미지 고르기<input type="file" id="imgIn" accept="image/*"></label>
          <button class="btn ghost" type="button" id="imgDel" hidden>빼기</button>
        </div>
        <div id="imgOpts" hidden>
          <div class="row" style="margin-bottom:12px"><span class="k">위치</span><div class="seg" data-key="imgPos"><button type="button" data-v="left">왼쪽</button><button type="button" data-v="top">위</button></div></div>
          <p class="hint" style="margin-bottom:10px">미리보기의 이미지를 끌면 위치가, 두 손가락(또는 Ctrl+휠)으로 확대가 바뀌어요.</p>
          <div style="display:flex;flex-direction:column;gap:8px">
            <label class="sl" for="imgX">좌우<input type="range" id="imgX" min="0" max="100" step="1"><output id="oX"></output></label>
            <label class="sl" for="imgY">위아래<input type="range" id="imgY" min="0" max="100" step="1"><output id="oY"></output></label>
            <label class="sl" for="imgZ">확대<input type="range" id="imgZ" min="100" max="400" step="1"><output id="oZ"></output></label>
          </div>
        </div>
      </div>

      <div class="sec">
        <h2>머리말 · 꼬리말</h2>
        <div class="row" style="gap:8px;flex-wrap:nowrap">
          <label class="f" for="title" style="flex:1.4">제목<input type="text" id="title"></label>
          <label class="f" for="sub" style="flex:1">부제<input type="text" id="sub"></label>
        </div>
        <div class="checks">
          <label for="sh_title"><input type="checkbox" id="sh_title" data-show="title"> 제목</label>
          <label for="sh_sub"><input type="checkbox" id="sh_sub" data-show="sub"> 부제</label>
          <label for="sh_sig"><input type="checkbox" id="sh_sig" data-show="sig"> 하단 서명</label>
        </div>
      </div>

      <div class="sec">
        <div class="row"><button class="btn ghost" type="button" id="reset">예시로 되돌리기</button></div>
      </div>
    </section>
  </div>
</div>

<div class="modal" id="modal" hidden>
  <p id="mmsg">이미지를 길게 누르거나(휴대폰) 우클릭(PC)해서 저장하세요.</p>
  <img id="mimg" alt="완성된 로그 이미지">
  <button class="btn ghost" type="button" id="mclose">닫기</button>
</div>
<div class="toast" id="toast" role="status" hidden></div>

<script>
const $=id=>document.getElementById(id);
const today=(()=>{const d=new Date();return d.getFullYear()+'.'+String(d.getMonth()+1).padStart(2,'0')+'.'+String(d.getDate()).padStart(2,'0')})();
const SAMPLE=`바이퍼: 하루, 사랑합니다.

그는 늘 그렇듯 무표정한 얼굴로 말했지만, 귀 끝이 조금 **붉어져** 있었다.

세레노: 저도요, 윤백 씨.`;
const MAXP=10;
const PALETTE=['#1262A7','#F4D9C7','#2E8B57','#C2410C','#7C3AED','#0E9F9A','#DB2777','#A16207','#475569','#65A30D'];
const DEF={src:SAMPLE,people:[{n:'바이퍼',l:'VIPER',c:'#1262A7'},{n:'세레노',l:'SERENO',c:'#F4D9C7'}],right:1,
  layout:'script',theme:'white',font:'mix',img:'',imgW:0,imgH:0,imgX:50,imgY:50,imgZ:1,imgPos:'left',
  title:'record.log',sub:today,show:{title:true,sub:true,sig:true},paras:[]};
const KEY='logmaker-v1';
let S;
try{S=Object.assign({},DEF,JSON.parse(localStorage.getItem(KEY)||'{}'))}catch(e){S=Object.assign({},DEF)}
S.show=Object.assign({},DEF.show,S.show||{});
if(!Array.isArray(S.people)||S.people.length<2){ // older saves kept two fixed people
  S.people=('nA' in S)?[{n:S.nA||'',l:S.lA||'',c:S.cA||PALETTE[0]},{n:S.nB||'',l:S.lB||'',c:S.cB||PALETTE[1]}]:JSON.parse(JSON.stringify(DEF.people));
  S.paras=[];}
['nA','lA','cA','nB','lB','cB'].forEach(k=>delete S[k]);
S.people=S.people.slice(0,MAXP);
if(typeof S.right!=='number')S.right=1;
function save(){try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){try{localStorage.setItem(KEY,JSON.stringify(Object.assign({},S,{img:''})))}catch(e2){}}}
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));

/* ---------- color ---------- */
const hex=h=>/^#[0-9a-f]{6}$/i.test(h)?h:'#888888';
const rgb=h=>[1,3,5].map(i=>parseInt(hex(h).substr(i,2),16));
const toHex=a=>'#'+a.map(v=>Math.round(clamp(v,0,255)).toString(16).padStart(2,'0')).join('');
const mix=(a,b,k)=>{const A=rgb(a),B=rgb(b);return toHex(A.map((v,i)=>v+(B[i]-v)*k))};
const lum=h=>{const c=rgb(h).map(v=>{v/=255;return v<=.03928?v/12.92:Math.pow((v+.055)/1.055,2.4)});return .2126*c[0]+.7152*c[1]+.0722*c[2]};
const contrast=(a,b)=>{const x=lum(a),y=lum(b);return (Math.max(x,y)+.05)/(Math.min(x,y)+.05)};
function readable(c,bg){const t=lum(bg)<.3?'#ffffff':'#000000';let o=hex(c);for(let i=1;i<=20&&contrast(o,bg)<4.5;i++)o=mix(c,t,i*.05);return o}
const rgba=(h,a)=>'rgba('+rgb(h).join(',')+','+a+')';

/* ---------- parsing ---------- */
const rx=v=>String(v||'').trim().replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
let PRE=/^\b\B/;
function setPre(){const ns=S.people.flatMap(p=>[p.n,p.l]).map(rx).filter(Boolean).sort((a,b)=>b.length-a.length);PRE=ns.length?new RegExp('^\\s*('+ns.join('|')+')\\s*[:：]\\s*','i'):/^\b\B/}
function split(t){t=String(t||'').replace(/\r/g,'').trim();if(!t)return[];
  let p=t.split(/\n\s*\n/);if(p.length===1&&!PRE.test(t))p=t.split(/\n/);
  const out=[];p.forEach(b=>{let cur=[];b.split('\n').forEach(l=>{if(cur.length&&(PRE.test(l)||PRE.test(cur[0]))){out.push(cur.join('\n'));cur=[]}cur.push(l)});if(cur.length)out.push(cur.join('\n'))});
  return out.map(x=>x.trim()).filter(Boolean)}
function guess(t){if(/^(그는|그녀는|그의|그녀의|그가|그녀가|그들은)/.test(t))return 'n';return 's'}
function parse(raw){const m=raw.match(PRE);if(!m)return null;const n=m[1].toLowerCase();
  const who=Math.max(0,S.people.findIndex(p=>[p.n,p.l].some(v=>v&&v.trim().toLowerCase()===n)));return {who,t:raw.slice(m[0].length).trim()}}
function syncParas(){const ps=split(S.src);const anyPre=ps.some(r=>PRE.test(r));const old=S.paras||[];
  S.paras=ps.map((raw,i)=>{const o=old[i],same=o&&o.raw===raw;if(same&&o.manual)return o;const pr=parse(raw);const off=same?!!o.off:false;
    if(pr)return {raw,t:pr.t,type:'s',who:pr.who,off};
    return {raw,t:raw,type:anyPre?'n':guess(raw),who:0,off}});
  S.paras.forEach(p=>{if(typeof p.who!=='number'||p.who>=S.people.length)p.who=0})}
function runs(s){const re=/\*\*(.+?)\*\*|==(.+?)==|\[\[(?:(\d{1,2})[:：])?(.+?)\]\]/g;const out=[];let last=0,m;
  while((m=re.exec(s))){if(m.index>last)out.push({t:s.slice(last,m.index),k:''});
    if(m[1]!=null)out.push({t:m[1],k:'b'});
    else if(m[2]!=null)out.push({t:m[2],k:'p1'});
    else{const i=m[3]?clamp(+m[3]-1,0,S.people.length-1):0;out.push({t:m[4],k:'p'+i})}
    last=re.lastIndex}
  if(last<s.length)out.push({t:s.slice(last),k:''});return out}
const labelOf=i=>{const p=S.people[i]||{};return (p.l||p.n||'').trim()||('인물 '+(i+1))};
const nameOf=i=>{const p=S.people[i]||{};return (p.n||p.l||'').trim()||('인물 '+(i+1))};

/* ---------- card layout (drawn on canvas so the PNG matches the preview exactly) ---------- */
const FAM={sans:'"Noto Sans KR","Apple SD Gothic Neo","Malgun Gothic",sans-serif',serif:'"Noto Serif KR","AppleMyungjo","Batang",serif',mono:'"IBM Plex Mono","Noto Sans KR",ui-monospace,monospace'};
const F=(w,s,f)=>w+' '+s+'px '+FAM[f];
const THEMES={white:{bg:'#ffffff',ink:'#1c1d21',muted:'#6f717a',rule:'#e7e8ec'},
  mist:{bg:'#eef0f3',ink:'#1a1d23',muted:'#626873',rule:'#d6dae1'},
  dark:{bg:'#141518',ink:'#ebebee',muted:'#9c9ea6',rule:'#2c2e34'}};
const mc=document.createElement('canvas').getContext('2d');
let IMG=null;
function trimEnd(L){while(L.length&&/^ +$/.test(L[L.length-1].t))L.pop()}
const lineW=L=>L.length?L[L.length-1].x+L[L.length-1].w:0;
function wrap(rs,maxW,base){
  const toks=[];rs.forEach(r=>r.t.split(/(\n| +)/).forEach(p=>{if(p!=='')toks.push({t:p,k:r.k})}));
  const lines=[[]];let x=0;const cur=()=>lines[lines.length-1];
  const fo=k=>F(k&&k!==''?base.wb:base.w,base.size,base.fam);
  for(const tk of toks){
    if(tk.t==='\n'){trimEnd(cur());lines.push([]);x=0;continue}
