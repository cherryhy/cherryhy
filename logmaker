function measureSp(t,font,ls){mc.font=font;let w=0;const cs=[...t];cs.forEach(c=>w+=mc.measureText(c).width);return w+ls*Math.max(0,cs.length-1)}

function build(){
  const T=THEMES[S.theme]||THEMES.white,dark=S.theme==='dark';
  const hasImg=!!(S.img&&IMG&&S.imgW),left=hasImg&&S.imgPos!=='top',top=hasImg&&S.imgPos==='top';
  const IW=400,IH=420,P=56,W=left?1080:720;
  const x0=(left?IW:0)+P,cw=(left?W-IW:W)-P*2;
  const raw=S.people.map(p=>hex(p.c)),col=raw.map(c=>readable(c,T.bg));
  const markOf=p=>p&&p.type==='s'?raw[p.who]:raw[1]||raw[0];let MARK=raw[1]||raw[0];
  const ops=[];let y=top?IH+P-4:P;
  const famSp=S.font==='serif'?'serif':'sans',famNr=S.font==='sans'?'sans':'serif';
  const B=(size,fam,w)=>({size,fam,w:w||400,wb:fam==='serif'?600:700});
  const emit=(L,x,yy,lh,base,color,center,w)=>L.forEach((ln,i)=>ops.push({k:'line',segs:ln,x:center?x+(w-lineW(ln))/2:x,y:yy+i*lh,lh,base,color,mark:MARK}));
  const ring=c=>dark?null:(lum(c)>.6?mix(c,'#000000',.22):null);

  let head=false;
  if(S.show.title&&String(S.title).trim()){const b=B(24,'sans',700);b.wb=700;const L=wrap(runs(S.title),cw,b);emit(L,x0,y,34,b,T.ink);y+=L.length*34;head=true}
  if(S.show.sub&&String(S.sub).trim()){if(head)y+=6;ops.push({k:'sp',t:S.sub,x:x0,y:y+8,font:F(500,11,'mono'),ls:1.2,color:T.muted});y+=16;head=true}
  if(head){y+=26;ops.push({k:'rect',x:x0,y,w:cw,h:1,fill:T.rule});y+=34}

  let vis=S.paras.filter(p=>!p.off);
  if(!vis.length)vis=[{type:'n',t:'글을 붙여넣으면 여기에 로그가 채워져요.'}];
  if(S.layout==='chat'){
    let prev=null;
    vis.forEach((p,i)=>{
      MARK=markOf(p);
      if(p.type==='s'){
        const same=prev&&prev.type==='s'&&prev.who===p.who,R=p.who===S.right;
        if(i)y+=same?6:22;
        if(!same){const t=labelOf(p.who),fo=F(700,11.5,'sans'),tw=measureSp(t,fo,1);
          ops.push({k:'sp',t,x:R?x0+cw-tw-6:x0+6,y:y+7,font:fo,ls:1,color:col[p.who]});y+=22}
        const b=B(15.5,famSp),mw=Math.round(cw*.76),L=wrap(runs(p.t),mw-36,b),lw=Math.max(12,...L.map(lineW));
        const bw=Math.ceil(lw)+36,bh=L.length*27+22,bx=R?x0+cw-bw:x0;
        ops.push({k:'bub',x:bx,y,w:bw,h:bh,R,tail:!same,fill:mix(T.bg,raw[p.who],dark?.24:.15),stroke:mix(T.bg,raw[p.who],dark?.38:.34)});
        emit(L,bx+18,y+11,27,b,T.ink);y+=bh;
      }else{
        if(i)y+=24;const b=B(14,famNr),w=cw*.84,L=wrap(runs(p.t),w,b);
        emit(L,x0+(cw-w)/2,y,25,b,T.muted,true,w);y+=L.length*25;
      }
      prev=p});
  }else{
    vis.forEach((p,i)=>{
      MARK=markOf(p);
      if(i)y+=26;
      if(p.type==='s'){
        ops.push({k:'dot',x:x0+4,y:y+8,r:4,fill:raw[p.who],stroke:ring(raw[p.who])});
        ops.push({k:'sp',t:labelOf(p.who),x:x0+18,y:y+8,font:F(700,12,'sans'),ls:1.3,color:col[p.who]});y+=26;
        const b=B(16,famSp),L=wrap(runs(p.t),cw-18,b);emit(L,x0+18,y,30,b,T.ink);y+=L.length*30;
      }else{
        const b=B(15,famNr),L=wrap(runs(p.t),cw,b);emit(L,x0,y,29,b,T.muted);y+=L.length*29;
      }});
  }
  if(S.show.sig){y+=42;ops.push({k:'rect',x:x0,y,w:cw,h:1,fill:T.rule});y+=22;
    const n=raw.length,names=S.people.map((_,i)=>labelOf(i)).join(n===2?'  ×  ':'  ·  ');
    const b={size:10.5,fam:'mono',w:500,wb:500},L=wrap([{t:names,k:''}],cw-n*14-20,b);emit(L,x0,y-3,18,b,T.muted);
    raw.forEach((c,i)=>ops.push({k:'dot',x:x0+cw-4-(n-1-i)*14,y:y+6,r:4,fill:c,stroke:ring(c)}));y+=12+(L.length-1)*18}
  y+=P;
  let H=Math.ceil(y);if(left)H=Math.max(H,640);
  return {W,H,ops,T,col,raw,dark,img:hasImg?{x:0,y:0,w:left?IW:W,h:left?H:IH}:null};
}
function coverGeom(r){const sc=Math.max(r.w/S.imgW,r.h/S.imgH)*S.imgZ,dw=S.imgW*sc,dh=S.imgH*sc;return {dw,dh,ox:r.x+(r.w-dw)*S.imgX/100,oy:r.y+(r.h-dh)*S.imgY/100}}
function bubPath(c,o){const r=18,t=o.tail?5:r,{x,y,w,h}=o;const tl=o.R?r:t,tr=o.R?t:r;
  c.beginPath();c.moveTo(x+tl,y);c.lineTo(x+w-tr,y);c.arcTo(x+w,y,x+w,y+tr,tr);c.lineTo(x+w,y+h-r);c.arcTo(x+w,y+h,x+w-r,y+h,r);
  c.lineTo(x+r,y+h);c.arcTo(x,y+h,x,y+h-r,r);c.lineTo(x,y+tl);c.arcTo(x,y,x+tl,y,tl);c.closePath()}
function paint(c,L,s){
  c.setTransform(s,0,0,s,0,0);c.fillStyle=L.T.bg;c.fillRect(0,0,L.W,L.H);
  if(L.img){const g=coverGeom(L.img);c.save();c.beginPath();c.rect(L.img.x,L.img.y,L.img.w,L.img.h);c.clip();c.drawImage(IMG,g.ox,g.oy,g.dw,g.dh);c.restore()}
  c.textBaseline='middle';
  for(const o of L.ops){
    if(o.k==='rect'){c.fillStyle=o.fill;c.fillRect(o.x,o.y,o.w,o.h)}
    else if(o.k==='dot'){c.beginPath();c.arc(o.x,o.y,o.r,0,Math.PI*2);c.fillStyle=o.fill;c.fill();if(o.stroke){c.lineWidth=1;c.strokeStyle=o.stroke;c.stroke()}}
    else if(o.k==='bub'){bubPath(c,o);c.fillStyle=o.fill;c.fill();c.lineWidth=1;c.strokeStyle=o.stroke;c.stroke()}
    else if(o.k==='sp'){c.font=o.font;c.fillStyle=o.color;let x=o.x;for(const ch of [...o.t]){c.fillText(ch,x,o.y);x+=c.measureText(ch).width+o.ls}}
    else if(o.k==='line'){const b=o.base,cy=o.y+o.lh/2;
      for(const g of o.segs){if(g.k==='b'){c.fillStyle=rgba(o.mark,L.dark?.32:.42);c.fillRect(o.x+g.x-1,cy+b.size*.06,g.w+2,b.size*.44)}}
      for(const g of o.segs){c.font=F(g.k?b.wb:b.w,b.size,b.fam);c.fillStyle=g.k&&g.k[0]==='p'?(L.col[+g.k.slice(1)]||o.color):o.color;c.fillText(g.t,o.x+g.x,cy)}}
  }
}

